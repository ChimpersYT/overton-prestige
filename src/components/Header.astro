---
import { site } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-ink/70 backdrop-blur-xl transition-colors duration-300"
>
  <div class="shell flex items-center justify-between h-[70px] md:h-20">
    <Logo />

    <nav class="hidden lg:flex items-center gap-8" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-display text-sm font-medium tracking-wide transition-colors',
              isActive(item.href) ? 'text-snow' : 'text-fog hover:text-snow',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={site.phoneHref}
        class="hidden sm:inline-flex btn btn-accent btn-sm"
      >
        <Icon name="phone" size={15} />
        <span>{site.phone}</span>
      </a>
      <button
        id="menu-toggle"
        class="lg:hidden grid place-items-center w-10 h-10 -mr-1 text-snow"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-line bg-ink">
    <nav class="shell py-5 flex flex-col" aria-label="Mobile">
      <a
        href="/"
        class="py-3 font-display text-base text-snow border-b border-line"
        >Home</a
      >
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="py-3 font-display text-base text-mist border-b border-line"
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.phoneHref} class="btn btn-accent mt-5">
        <Icon name="phone" size={16} /> Call {site.phone}
      </a>
      <a href={site.whatsappHref} class="btn btn-outline mt-3">
        <Icon name="whatsapp" size={16} /> WhatsApp us
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  });

  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
    }),
  );
</script>

<style>
  #site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    border-bottom: 1px solid var(--color-line);
  }
</style>
