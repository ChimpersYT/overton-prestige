---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const steps = [
  {
    icon: 'search',
    title: 'Tell us the spec',
    body: 'Make, model, trim, colour, options and budget. The more detail you give us, the closer the match.',
  },
  {
    icon: 'handshake',
    title: 'We search our network',
    body: 'We work through a nationwide network of trusted trade contacts to locate the right car at the right price.',
  },
  {
    icon: 'shield-check',
    title: 'We prepare it',
    body: 'Once found, the car is fully checked and presented properly before you ever see it.',
  },
  {
    icon: 'key',
    title: 'Collection or delivery',
    body: 'Hand-over at our Hilton showroom, or delivered to your door anywhere in the UK.',
  },
];

const sourcable = [
  'Audi RS and S performance models',
  'Prestige SUVs and 4x4s',
  'Luxury saloons and estates',
  'Specific colour and option builds',
  'Commercial vans for business',
  'Low-availability and hard-to-find cars',
];
---

<Layout
  title="Vehicle Sourcing"
  description="Tell Overton Prestige the exact car you want and we will find it through our nationwide trade network, then prepare and deliver it."
>
  <PageHeader
    eyebrow="Vehicle sourcing"
    title="Tell us the car. We will find it."
    lead="Most of what we sell never reaches a forecourt. Describe exactly what you are after and we locate it through our nationwide trade network, then prepare and hand it over."
  />

  <section class="section">
    <div class="shell">
      <h2 class="font-display text-2xl md:text-3xl font-semibold text-snow">
        How sourcing works
      </h2>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          steps.map((step, i) => (
            <div class="surface p-6 reveal">
              <div class="flex items-center justify-between">
                <div class="grid place-items-center w-11 h-11 rounded-lg bg-accent/12 text-accent">
                  <Icon name={step.icon} size={20} />
                </div>
                <span class="font-display text-sm font-bold text-ink-300">
                  0{i + 1}
                </span>
              </div>
              <h3 class="mt-5 font-display text-lg font-semibold text-snow">
                {step.title}
              </h3>
              <p class="mt-2 text-sm text-fog leading-relaxed">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="shell">
      <div class="surface p-8 md:p-10">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
          <div>
            <span class="eyebrow">What we source</span>
            <h2
              class="mt-4 font-display text-2xl md:text-3xl font-semibold text-snow text-balance"
            >
              If it is on the road, we can usually find it
            </h2>
            <p class="mt-4 text-mist leading-relaxed">
              Our focus is prestige and performance, but the sourcing service is
              not limited to it. If you have a specific car in mind, start a
              search and we will tell you honestly what is realistic.
            </p>
          </div>
          <ul class="grid sm:grid-cols-2 gap-3">
            {
              sourcable.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-mist">
                  <Icon
                    name="check"
                    size={16}
                    class="text-accent shrink-0 mt-0.5"
                  />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="shell">
      <div
        class="surface p-6 md:p-10 grid lg:grid-cols-[1fr_1.4fr] gap-10 lg:gap-16"
      >
        <div>
          <span class="eyebrow">Start a search</span>
          <h2
            class="mt-4 font-display text-2xl md:text-3xl font-semibold text-snow text-balance"
          >
            Describe your car
          </h2>
          <p class="mt-4 text-mist leading-relaxed">
            Send us the details and we will come back to you, usually the same
            day, with what we can do and a realistic price.
          </p>
          <div class="mt-6 flex flex-col gap-2.5 text-sm">
            <a
              href={site.phoneHref}
              class="inline-flex items-center gap-2.5 text-mist hover:text-snow transition-colors"
            >
              <Icon name="phone" size={16} class="text-accent" />
              {site.phone}
            </a>
            <a
              href={site.whatsappHref}
              class="inline-flex items-center gap-2.5 text-mist hover:text-snow transition-colors"
            >
              <Icon name="whatsapp" size={16} class="text-accent" />
              Message us on WhatsApp
            </a>
          </div>
        </div>
        <EnquiryForm
          subject="Vehicle sourcing enquiry"
          submitLabel="Send sourcing enquiry"
          fields={[
            { name: 'name', label: 'Your name', required: true },
            { name: 'phone', label: 'Phone', type: 'tel', required: true },
            { name: 'email', label: 'Email', type: 'email' },
            {
              name: 'vehicle',
              label: 'Car you are looking for',
              placeholder: 'e.g. Audi RS3 Saloon, Carbon Vorsprung',
              required: true,
              full: true,
            },
            {
              name: 'budget',
              label: 'Budget',
              placeholder: 'e.g. up to £75,000',
            },
            {
              name: 'timeframe',
              label: 'Timeframe',
              type: 'select',
              options: [
                'As soon as possible',
                'Within a month',
                'One to three months',
                'Just exploring for now',
              ],
            },
            {
              name: 'details',
              label: 'Anything else',
              type: 'textarea',
              placeholder:
                'Colour, options, mileage limit, part-exchange, delivery area...',
            },
          ]}
        />
      </div>
    </div>
  </section>
</Layout>
