---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const mapEmbed =
  'https://maps.google.com/maps?q=' +
  encodeURIComponent(
    `Overton Prestige, Hilton, Derby, ${site.address.postcode}`,
  ) +
  '&t=&z=14&ie=UTF8&iwloc=&output=embed';
---

<Layout
  title="Find Us"
  description="Visit Overton Prestige at Leisure Kingdom, Hilton, Derby, DE65 5FJ. Viewings by appointment. Call 07539 075275."
>
  <PageHeader
    eyebrow="Find us"
    title="Visit the showroom"
    lead="We are based at Leisure Kingdom in Hilton, just outside Derby. Viewings are by appointment, so call or message ahead and we will have everything ready for you."
  />

  <section class="section">
    <div class="shell">
      <div class="grid lg:grid-cols-[1fr_1.1fr] gap-6 lg:gap-10">
        {/* Contact details */}
        <div class="flex flex-col gap-5">
          <div class="surface p-6 flex gap-4">
            <div class="grid place-items-center w-11 h-11 rounded-lg bg-accent/12 text-accent shrink-0">
              <Icon name="pin" size={20} />
            </div>
            <div>
              <h2 class="font-display text-base font-semibold text-snow">
                Address
              </h2>
              <address class="mt-1 not-italic text-sm text-mist leading-relaxed">
                {site.address.line1}, {site.address.line2}<br />
                {site.address.city}, {site.address.county}, {site.address.postcode}
              </address>
              <a
                href={site.mapsHref}
                target="_blank"
                rel="noopener"
                class="mt-2 inline-flex items-center gap-1 text-sm text-accent font-display font-semibold"
              >
                Get directions <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
          </div>

          <div class="surface p-6 flex gap-4">
            <div class="grid place-items-center w-11 h-11 rounded-lg bg-accent/12 text-accent shrink-0">
              <Icon name="phone" size={20} />
            </div>
            <div>
              <h2 class="font-display text-base font-semibold text-snow">
                Get in touch
              </h2>
              <div class="mt-1.5 flex flex-col gap-1.5 text-sm">
                <a
                  href={site.phoneHref}
                  class="text-mist hover:text-snow transition-colors"
                  >{site.phone}</a
                >
                <a
                  href={`mailto:${site.email}`}
                  class="text-mist hover:text-snow transition-colors"
                  >{site.email}</a
                >
                <a
                  href={site.whatsappHref}
                  target="_blank"
                  rel="noopener"
                  class="text-mist hover:text-snow transition-colors inline-flex items-center gap-1.5"
                >
                  <Icon name="whatsapp" size={14} /> WhatsApp us
                </a>
              </div>
            </div>
          </div>

          <div class="surface p-6 flex gap-4">
            <div class="grid place-items-center w-11 h-11 rounded-lg bg-accent/12 text-accent shrink-0">
              <Icon name="clock" size={20} />
            </div>
            <div class="flex-1">
              <h2 class="font-display text-base font-semibold text-snow">
                Opening hours
              </h2>
              <ul class="mt-2 flex flex-col gap-1.5 text-sm">
                {
                  site.hours.map((h) => (
                    <li class="flex justify-between gap-4">
                      <span class="text-fog">{h.day}</span>
                      <span
                        class={
                          h.time === 'Closed' ? 'text-fog' : 'text-mist'
                        }
                      >
                        {h.time}
                      </span>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-3 text-xs text-accent">{site.hoursNote}</p>
            </div>
          </div>
        </div>

        {/* Map */}
        <div class="surface overflow-hidden min-h-[320px] lg:min-h-0">
          <iframe
            title="Map showing the location of Overton Prestige in Hilton, Derby"
            src={mapEmbed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full min-h-[320px] border-0"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="shell">
      <div class="surface p-6 md:p-10">
        <div class="max-w-xl">
          <span class="eyebrow">Send a message</span>
          <h2
            class="mt-4 font-display text-2xl md:text-3xl font-semibold text-snow text-balance"
          >
            Ask us anything
          </h2>
          <p class="mt-3 text-mist leading-relaxed">
            A question about a car, sourcing, finance or a visit. Send it over
            and we will get back to you, usually the same day.
          </p>
        </div>
        <div class="mt-7">
          <EnquiryForm
            subject="Website enquiry"
            submitLabel="Send message"
            fields={[
              { name: 'name', label: 'Your name', required: true },
              { name: 'phone', label: 'Phone', type: 'tel' },
              {
                name: 'email',
                label: 'Email',
                type: 'email',
                required: true,
              },
              {
                name: 'subject',
                label: 'Subject',
                placeholder: 'What is it about?',
              },
              {
                name: 'message',
                label: 'Message',
                type: 'textarea',
                required: true,
              },
            ]}
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
